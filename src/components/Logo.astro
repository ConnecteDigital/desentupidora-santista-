---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';

interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
const width = size === 'lg' ? 160 : 72;
---

<Image class:list={['logo', `logo-${size}`]} src={logo} alt={site.name} width={width} height={width} densities={[1, 2]} loading={size === 'sm' ? 'eager' : 'lazy'} />
