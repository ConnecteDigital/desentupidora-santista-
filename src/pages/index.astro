---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import { Image } from 'astro:assets';
import { fotoDoServico, temFotos } from '../data/fotos';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { bairrosPorZona, bairroPath, zonasPrioritarias } from '../data/bairros';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const faq = [
  {
    q: 'O atendimento é 24 horas mesmo?',
    a: `Sim. Atendemos 24 horas por dia, 7 dias por semana, incluindo fins de semana e feriados, em toda a ${site.region}.`,
  },
  {
    q: 'Quais cidades vocês atendem?',
    a: 'Santos, São Vicente, Guarujá, Praia Grande, Cubatão, Bertioga, Mongaguá, Itanhaém e Peruíbe.',
  },
  {
    q: 'Precisa quebrar piso ou parede para desentupir?',
    a: 'Na grande maioria dos casos, não. Trabalhamos com máquinas que alcançam a obstrução por dentro da tubulação. Só indicamos abertura quando o cano está quebrado, e sempre com o seu aceite antes.',
  },
  {
    q: 'O desentupimento tem garantia?',
    a: `Sim. Todos os serviços da ${site.name} têm garantia.`,
  },
  {
    q: 'Como chamo a desentupidora?',
    a: `É só chamar no WhatsApp ou ligar no ${site.phoneCall}. Conte o que está entupido, de preferência com uma foto ou vídeo, e um técnico sai para o seu endereço.`,
  },
];

import fundoTopo from '../assets/topo.jpg';
const fotoEquipe = fotoDoServico('desentupimento-de-esgoto');

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base
  title="Desentupidora 24 Horas em Santos e Baixada Santista | Desentupidora Santista"
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class="hero hero-home">
    {
      fundoTopo && (
        <Image
          class="hero-bg"
          src={fundoTopo}
          alt=""
          widths={[480, 800, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="container hero-center">
      <span class="eyebrow">Desentupidora na Baixada Santista · Plantão 24h</span>
      <h1>Desentupidora 24 horas em Santos e região: <em>sem quebra-quebra</em></h1>
      <p class="hero-lead">Pia, vaso, ralo ou esgoto entupido? Resolvemos hoje, a qualquer hora, com garantia.</p>
      <CtaButtons />
      <ul class="hero-badges">
        <li><Icon name="clock" size={22} /> <span>Atendimento 24h</span></li>
        <li><Icon name="bolt" size={22} /> <span>Sem quebrar piso</span></li>
        <li><Icon name="shield" size={22} /> <span>Serviço com garantia</span></li>
      </ul>
    </div>
  </section>

  <section class="trust" aria-label="Diferenciais">
    <div class="container trust-grid">
      <div class="trust-item"><Icon name="clock" size={34} /><div><strong>24 horas</strong><span>Todos os dias, inclusive feriados</span></div></div>
      <div class="trust-item"><Icon name="drain" size={34} /><div><strong>Sem quebra-quebra</strong><span>Máquinas próprias</span></div></div>
      <div class="trust-item"><Icon name="shield" size={34} /><div><strong>Garantia</strong><span>Em todos os serviços</span></div></div>
      <div class="trust-item"><Icon name="pin" size={34} /><div><strong>Baixada Santista</strong><span>De Bertioga a Peruíbe</span></div></div>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Desentupimento na Baixada Santista</h2>
        <p>Da pia da cozinha à rede de esgoto: desentupimos casas, apartamentos, condomínios e comércios.</p>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao cano desentupido</h2>
        <p>Sem enrolação: você chama, a gente vai e resolve.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Chame no WhatsApp ou ligue</h3>
          <p>Conte o que está entupido. Se puder, mande uma foto ou um vídeo do problema.</p>
        </div>
        <div class="step-card">
          <h3>Um técnico vai até você</h3>
          <p>Assim que você chama, um técnico sai para o endereço com as máquinas certas para o serviço.</p>
        </div>
        <div class="step-card">
          <h3>Desentupido e com garantia</h3>
          <p>Desobstruímos, testamos o escoamento na sua frente e deixamos o local limpo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class:list={['container', fotoEquipe ? 'about-grid' : '']}>
      {
        fotoEquipe && (
          <div class="about-photo">
            <Image src={fotoEquipe.src} alt={fotoEquipe.alt} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        )
      }
      <div>
      <div class="section-head">
        <span class="eyebrow">Por que a {site.name}</span>
        <h2>Desentupidora de confiança, a qualquer hora</h2>
        <p>Equipe equipada para resolver desde um ralo de box até a rede de esgoto inteira.</p>
      </div>
      <div class="features">
        <div class="feature">
          <Icon name="clock" size={30} />
          <div><h3>Plantão 24 horas</h3><p>Entupimento não espera horário comercial. Atendemos de madrugada, fins de semana e feriados.</p></div>
        </div>
        <div class="feature">
          <Icon name="drain" size={30} />
          <div><h3>Sem quebra-quebra</h3><p>Máquinas de cabo rotativo e jato de alta pressão alcançam o entupimento por dentro do cano, sem abrir piso.</p></div>
        </div>
        <div class="feature">
          <Icon name="shield" size={30} />
          <div><h3>Garantia no serviço</h3><p>Todo desentupimento sai com garantia. Se voltar a entupir, voltamos para resolver.</p></div>
        </div>
        <div class="feature">
          <Icon name="pin" size={30} />
          <div><h3>Conhecemos a Baixada</h3><p>Areia da praia, prédios antigos da orla e imóveis de temporada: sabemos o que entope por aqui.</p></div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <CtaBand />

  {
    temFotos() && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Nosso trabalho</span>
            <h2>Nossos serviços em ação</h2>
            <p>Desentupimento de pia, vaso, esgoto, caixa de gordura e hidrojateamento na Baixada Santista.</p>
          </div>
          <Gallery limit={8} />
        </div>
      </section>
    )
  }

  <section class="section section-soft" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Áreas atendidas</span>
        <h2>Desentupidora perto de você</h2>
        <p>Atendemos toda a Baixada Santista, de Bertioga a Peruíbe.</p>
      </div>
      <div class="zones">
        {
          bairrosPorZona().map((g) => (
            <div class:list={['zone', { 'is-priority': zonasPrioritarias.includes(g.zona) }]}>
              <h3>
                {g.zona}
                {zonasPrioritarias.includes(g.zona) && <span class="tag">Foco</span>}
              </h3>
              <ul>
                {g.bairros.map((b) => (
                  <li>
                    <a href={bairroPath(b)}>
                      <Icon name="pin" size={16} /> Desentupidora em {b.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Blog</span>
            <h2>Dicas contra entupimento</h2>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.data.toISOString()}>{p.data.data.toLocaleDateString('pt-BR')}</time>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.descricao}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-soft">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Precisa desentupir agora?" />
</Base>
